# PETE MCP Gateway — environment template.
# NAMES ONLY. Real values live in the server-side .env (never committed) or the
# host secret store. Per SECURITY_BOUNDARIES.md, no secret value ever appears in
# git, chat, or MCP tool output.

# ── Gateway core ────────────────────────────────────────────────────────────
# Direct Postgres to the Supabase "MCP" project (gateway schema lives there).
# Use the session pooler URL with a dedicated role, not the service role.
DATABASE_URL=
GATEWAY_PUBLIC_URL=https://mcp.by-pete.com
GATEWAY_ENV=production
GATEWAY_LOG_LEVEL=INFO

# ── Supabase instances (multi-instance: NAME in {ZODA, PZLO, MCPDB}) ────────
SUPABASE_ZODA_URL=https://ezlmmegowggujpcnzoda.supabase.co
SUPABASE_ZODA_SERVICE_KEY=
SUPABASE_PZLO_URL=https://qzwxisdfwswsrbzvpzlo.supabase.co
SUPABASE_PZLO_SERVICE_KEY=
SUPABASE_MCPDB_URL=https://gjaerlqdnsdveoxedpgk.supabase.co
SUPABASE_MCPDB_SERVICE_KEY=

# ── Epicor (multi-company via API key per company; GET-only OData) ──────────
EPICOR_BASE_URL=https://epicor.buntingmagnetics.com/EpicorProd
EPICOR_USER=
EPICOR_PASSWORD=
EPICOR_API_KEY_BMC=
EPICOR_API_KEY_BME=
EPICOR_API_KEY_MAI=

# ── Gmail / Google Workspace (multi-account: NAME in {PETE, LEAN}) ──────────
GMAIL_PETE_CLIENT_ID=
GMAIL_PETE_CLIENT_SECRET=
GMAIL_PETE_REFRESH_TOKEN=
GMAIL_LEAN_CLIENT_ID=
GMAIL_LEAN_CLIENT_SECRET=
GMAIL_LEAN_REFRESH_TOKEN=

# ── SaaS connectors ─────────────────────────────────────────────────────────
GITHUB_TOKEN=
HUBSPOT_TOKEN=
STRIPE_API_KEY=
NETLIFY_TOKEN=
SLACK_BOT_TOKEN=
HEYGEN_API_KEY=
MAKE_API_TOKEN=
CLOUDFLARE_API_TOKEN=
MS365_TENANT_ID=
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=

# ── LLM providers (worker-side model calls; Flash=workers, Sonnet=planners) ─
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ── VPS health endpoints (no SSH from gateway; HTTP health only) ────────────
VPS_MAGGIE_HEALTH_URL=
VPS_BUNTING_HEALTH_URL=
VPS_PETE_HEALTH_URL=
